:root {
    --inventory-slot-size: 64px;
    --inventory-gap: 6px;
    --inventory-panel-background: rgba(12, 16, 24, 0.94);
    --inventory-slot-background: rgba(31, 39, 53, 0.96);
    --inventory-slot-border: rgba(170, 185, 205, 0.7);
    --inventory-selected-border: rgb(255, 214, 76);
    --inventory-text-color: rgb(245, 247, 250);
}

.inventory-ui-root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    flex-grow: 1;
    align-items: center;
    justify-content: flex-end;
    padding-bottom: 28px;
    padding-left: 20px;
    padding-right: 20px;
}

.inventory-hotbar {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-height: 80px;
    padding: 8px;
    background-color: var(--inventory-panel-background);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.inventory-hotbar-slots {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    flex-wrap: nowrap;
}

.inventory-slot {
    position: relative;
    width: var(--inventory-slot-size);
    height: var(--inventory-slot-size);
    flex-shrink: 0;
    margin-left: 3px;
    margin-right: 3px;
    padding: 4px;
    align-items: center;
    justify-content: center;
    background-color: var(--inventory-slot-background);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-color: var(--inventory-slot-border);
    border-right-color: var(--inventory-slot-border);
    border-top-color: var(--inventory-slot-border);
    border-bottom-color: var(--inventory-slot-border);
    color: var(--inventory-text-color);
}

.inventory-slot:hover {
    background-color: rgb(63, 76, 96);
}

.inventory-slot--occupied {
    opacity: 1;
}

.inventory-slot--selected {
    border-left-color: var(--inventory-selected-border);
    border-right-color: var(--inventory-selected-border);
    border-top-color: var(--inventory-selected-border);
    border-bottom-color: var(--inventory-selected-border);
    background-color: rgb(70, 67, 42);
}

.inventory-slot--empty {
    opacity: 0.58;
}

.inventory-slot--unavailable {
    opacity: 0.36;
}

.inventory-slot__key {
    position: absolute;
    left: 5px;
    top: 3px;
    font-size: 12px;
    color: rgb(215, 222, 232);
    -unity-font-style: bold;
}

.inventory-slot__icon {
    width: 38px;
    height: 38px;
}

.inventory-slot__count {
    position: absolute;
    right: 5px;
    bottom: 3px;
    font-size: 14px;
    color: var(--inventory-text-color);
    -unity-font-style: bold;
}

.inventory-slot__name {
    max-width: 54px;
    margin-top: 3px;
    font-size: 9px;
    color: var(--inventory-text-color);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    -unity-text-align: middle-center;
}

.inventory-additional-panel {
    display: none;
    position: absolute;
    top: 70px;
    bottom: 150px;
    width: 720px;
    height: auto;
    min-height: 0;
    max-height: none;
    flex-direction: column;
    background-color: var(--inventory-panel-background);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.inventory-additional-panel--visible {
    display: flex;
}

.inventory-panel-header {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.inventory-panel-title {
    color: var(--inventory-text-color);
    font-size: 18px;
    -unity-font-style: bold;
}

.inventory-panel-toggle {
    min-width: 70px;
    padding-left: 10px;
    padding-right: 10px;
    color: var(--inventory-text-color);
}

.inventory-chest-panel {
    display: none;
    flex-direction: column;
    flex-shrink: 0;
    padding-left: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    margin-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(170, 185, 205, 0.35);
}

.inventory-chest-title {
    color: var(--inventory-text-color);
    font-size: 15px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.inventory-chest-content {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}

.inventory-player-title {
    color: var(--inventory-text-color);
    font-size: 14px;
    margin-left: 8px;
    margin-bottom: 4px;
    -unity-font-style: bold;
}

.inventory-additional-scroll {
    flex-grow: 1;
    min-height: 70px;
}

.inventory-additional-content {
    width: 100%;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: flex-start;
}


.crafting-content {
    display: none;
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: auto;
    min-height: 0;
    height: auto;
    overflow: hidden;
}

.crafting-content--visible {
    display: flex;
}

.crafting-toolbar {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
}

.crafting-return-button,
.crafting-station-button {
    min-height: 28px;
    padding-left: 8px;
    padding-right: 8px;
    color: var(--inventory-text-color);
}

.crafting-unavailable-toggle {
    flex-direction: row;
    align-items: center;
    color: var(--inventory-text-color);
    margin-left: 8px;
    margin-right: 8px;
}

.crafting-unavailable-toggle .unity-toggle__label {
    color: var(--inventory-text-color);
}

.crafting-station-selector {
    flex-direction: row;
    align-items: center;
}
.crafting-station-button {
    margin-left: 4px;
}

.crafting-station-button.crafting-station--active {
    border-left-color: var(--inventory-selected-border);
    border-right-color: var(--inventory-selected-border);
    border-top-color: var(--inventory-selected-border);
    border-bottom-color: var(--inventory-selected-border);
    background-color: rgb(70, 67, 42);
}

.crafting-station-button.crafting-station--locked {
    opacity: 0.38;
}

.crafting-recipe-scroll {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: auto;
    min-height: 0;
    height: auto;
    overflow: hidden;
}

.crafting-recipe-list {
    width: 100%;
    flex-shrink: 0;
    padding-right: 4px;
}

.crafting-recipe-card {
    flex-direction: column;
    flex-shrink: 0;
    margin-bottom: 6px;
    padding: 8px;
    background-color: rgba(31, 39, 53, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(170, 185, 205, 0.45);
    border-right-color: rgba(170, 185, 205, 0.45);
    border-top-color: rgba(170, 185, 205, 0.45);
    border-bottom-color: rgba(170, 185, 205, 0.45);
}

.crafting-recipe-card--unavailable {
    opacity: 0.6;
}

.crafting-recipe-output {
    flex-direction: row;
    align-items: center;
    min-height: 42px;
}

.crafting-recipe-output-icon {
    width: 38px;
    height: 38px;
    margin-right: 8px;
}

.crafting-recipe-output-text {
    flex-grow: 1;
    color: var(--inventory-text-color);
    font-size: 15px;
    -unity-font-style: bold;
}

.crafting-recipe-ingredients {
    margin-top: 4px;
    margin-bottom: 6px;
}

.crafting-recipe-ingredient {
    color: rgb(215, 222, 232);
    font-size: 12px;
}

.crafting-recipe-ingredient--missing {
    color: rgb(236, 120, 112);
}

.crafting-recipe-button {
    min-height: 28px;
    color: var(--inventory-text-color);
}

.crafting-recipe-button:disabled {
    opacity: 0.4;
}


.inventory-slot,
.inventory-panel-toggle,
.crafting-return-button,
.crafting-station-button,
.crafting-recipe-button {
    background-image: none;
    background-color: rgb(31, 39, 53);
    color: rgb(245, 247, 250);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(170, 185, 205, 0.7);
    border-right-color: rgba(170, 185, 205, 0.7);
    border-top-color: rgba(170, 185, 205, 0.7);
    border-bottom-color: rgba(170, 185, 205, 0.7);
}

.inventory-slot .unity-button__text,
.inventory-panel-toggle .unity-button__text,
.crafting-return-button .unity-button__text,
.crafting-station-button .unity-button__text,
.crafting-recipe-button .unity-button__text {
    color: rgb(245, 247, 250);
}

.inventory-slot:hover,
.inventory-panel-toggle:hover,
.crafting-return-button:hover,
.crafting-station-button:hover,
.crafting-recipe-button:hover {
    background-color: rgb(63, 76, 96);
}

.inventory-slot.inventory-slot--selected {
    background-color: rgb(70, 67, 42);
    border-left-width: 3px;
    border-right-width: 3px;
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-color: rgb(255, 214, 76);
    border-right-color: rgb(255, 214, 76);
    border-top-color: rgb(255, 214, 76);
    border-bottom-color: rgb(255, 214, 76);
}


.inventory-item-tooltip {
    display: none;
    position: absolute;
    min-width: 150px;
    max-width: 260px;
    padding-left: 10px;
    padding-right: 10px;
    padding-top: 7px;
    padding-bottom: 7px;
    background-color: rgba(10, 14, 22, 0.96);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(170, 185, 205, 0.9);
    border-right-color: rgba(170, 185, 205, 0.9);
    border-top-color: rgba(170, 185, 205, 0.9);
    border-bottom-color: rgba(170, 185, 205, 0.9);
}

.inventory-item-tooltip__name {
    color: rgb(245, 247, 250);
    font-size: 14px;
    -unity-font-style: bold;
}

.inventory-item-tooltip__kind {
    margin-top: 3px;
    color: rgb(215, 222, 232);
    font-size: 12px;
}

